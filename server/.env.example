# Copy to server/.env (never commit the real file — .env is gitignored).
# The local SQLite backend (server/server.js + server/auth.js) reads these.

# Signs the login JWTs. REQUIRED for a public deployment: with NODE_ENV=production
# the server refuses to start without it, and without it in any other mode it
# signs with a built-in secret that is public in this repository, so anyone could
# mint a valid token. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every user out.
HBR_JWT_SECRET=

# Optional. Comma-separated user ids that get admin rights (guide approval and
# entry deletion). Defaults to the built-in owner id in server/server.js.
# HBR_ADMIN_IDS=

# Optional. API port, default 8123. Caddy reverse-proxies /api/* here.
# PORT=8123

# Set to production on a real deployment so the missing-secret guard above applies.
# NODE_ENV=production
